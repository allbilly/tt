+                                        uint32_t src_a_fmt, uint32_t src_b_fmt, uint32_t fidelity_phase,
+                                        uint32_t dest_accum_en) {
+    fprintf(file,
+        ",\"%s\":{\"src_a\":{\"bank\":%u,\"valid_mask\":%u,\"valid\":%s,\"format\":%u,\"row_start\":%u,\"rows\":[",
+        name, src_a_bank, p_tensix->src_a_valid,
+        (p_tensix->src_a_valid & (1 << src_a_bank)) ? "true" : "false", src_a_fmt, src_a_row);
+    for (uint32_t row = 0; row < 8; row++) {
+        fprintf(file, "%s[", row ? "," : "");
+        for (uint32_t col = 0; col < ROW_SIZE; col++) {
+            fprintf(file, "%s\"0x%08x\"", col ? "," : "", p_tensix->src_a[src_a_bank][src_a_row + row][col]);
+        }
+        fputc(']', file);
+    }
+    fprintf(file,
+        "]},\"src_b\":{\"bank\":%u,\"valid_mask\":%u,\"valid\":%s,\"format\":%u,\"row_start\":%u,\"rows\":[",
+        src_b_bank, p_tensix->src_b_valid,
+        (p_tensix->src_b_valid & (1 << src_b_bank)) ? "true" : "false", src_b_fmt, src_b_row);
+    for (uint32_t row = 0; row < 8; row++) {
+        fprintf(file, "%s[", row ? "," : "");
+        for (uint32_t col = 0; col < ROW_SIZE; col++) {
+            fprintf(file, "%s\"0x%08x\"", col ? "," : "", p_tensix->src_b[src_b_bank][src_b_row + row][col]);
+        }
+        fputc(']', file);
+    }
+    fprintf(file,
+        "]},\"dst\":{\"row_start\":%u,\"rows\":[", dst_row);
+    for (uint32_t row = 0; row < 8; row++) {
+        uint32_t current_row = dst_row + row;
+        fprintf(file, "%s{\"row\":%u,\"valid\":%s,\"internal_u16\":[",
+                row ? "," : "", current_row, p_tensix->dst_row_valid[current_row] ? "true" : "false");
+        for (uint32_t col = 0; col < ROW_SIZE; col++) {
+            fprintf(file, "%s\"0x%04x\"", col ? "," : "", p_tensix->dst[current_row][col]);
+        }
+        fputs("],\"decoded_bf16\":[", file);
+        for (uint32_t col = 0; col < ROW_SIZE; col++) {
+            fprintf(file, "%s\"0x%04x\"", col ? "," : "", dst_decode_bf16(p_tensix->dst[current_row][col]));
+        }
+        fputs("]}", file);
+    }
+    fprintf(file,
+        "]},\"control\":{\"state_id\":%u,\"src_a_format\":%u,\"src_b_format\":%u,"
+        "\"dst_format\":%u,\"fp32_enabled\":%u,\"int8_enabled\":%u,"
+        "\"flush_denormals\":%u,\"dest_accum_en\":%u,\"fidelity_counter\":%u,"
