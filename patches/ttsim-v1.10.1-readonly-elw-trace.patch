+// Opt-in read-only ELW trace. Filters are fixed at compile time for this build.
+static bool tensix_trace_matches(const char *operation, uint32_t tile_id, uint32_t pipe) {
+    uint32_t operation_bit = operation[3] == 'A' ? 1u : (operation[3] == 'M' ? 2u : 4u);
+    return tile_id == TTSIM_ELW_TRACE_TILE_ID && pipe == TTSIM_ELW_TRACE_PIPE &&
+        (TTSIM_ELW_TRACE_OPERATION_MASK & operation_bit) != 0;
+}
+
+static bool tensix_trace_begin(const char *operation, uint32_t tile_id, uint32_t pipe,
+                               uint32_t word, const char *status) {
+    if (!tensix_trace_matches(operation, tile_id, pipe)) {
+        return false;
+    }
+    fprintf(stderr,
+        "{\"event\":\"tensix_execute_callback\",\"status\":\"%s\",\"chip\":\"Blackhole\","
+        "\"tile_id\":%u,\"tile\":{\"x\":%u,\"y\":%u},\"pipe\":%u,\"operation\":\"%s\","
+        "\"instruction_word\":\"0x%08x\",\"decoded\":{\"opcode\":%u,\"dst\":%u,"
+        "\"addr_mode\":%u,\"instr_mod19\":%u,\"dest_accum_en\":%u,\"clear_dvalid\":%u}",
+        status, tile_id, tile_id % 14 + (tile_id % 14 >= 7 ? 3 : 1), tile_id / 14 + 2, pipe, operation, word,
+        (word >> 24) & 0xff, word & 0x3ff, (word >> 14) & 7, (word >> 19) & 3,
+        (word >> 21) & 1, (word >> 22) & 3);
+    return true;
+}
