+static void tensix_trace_issue(TensixState *p_tensix, uint32_t pipe, uint32_t slot, uint32_t inst) {
+    uint32_t opcode = bits<31,24>(inst);
+    if (opcode != 0x27 && opcode != 0x28 && opcode != 0x30) {
+        return;
+    }
+    const char *operation = opcode == 0x27 ? "ELWMUL" : (opcode == 0x30 ? "ELWSUB" : "ELWADD");
+    if (!tensix_trace_matches(operation, p_tensix->tile_id, pipe)) {
+        return;
+    }
+    fprintf(stderr,
+        "{\"event\":\"tensix_instruction_issue\",\"status\":\"issued\",\"chip\":\"Blackhole\","
+        "\"tile_id\":%u,\"tile\":{\"x\":%u,\"y\":%u},\"pipe\":%u,\"queue_slot\":%u,"
+        "\"queue_slot_kind\":\"per-pipe FIFO position, not Tensix stream-table offset\","
+        "\"operation\":\"%s\",\"instruction_word\":\"0x%08x\",\"issuer_pc\":null}\n",
+        p_tensix->tile_id, p_tensix->tile_id % 14 + (p_tensix->tile_id % 14 >= 7 ? 3 : 1), p_tensix->tile_id / 14 + 2,
+        pipe, slot, operation, inst);
+}
